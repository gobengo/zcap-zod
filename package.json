{
  "name": "zcap-zod",
  "version": "0.1.0",
  "description": "Zod schemas for W3C CCG Authorization Capabilities (zcaps): root zcaps, delegated zcaps, and capability invocations.",
  "keywords": [
    "zcap",
    "authorization-capabilities",
    "ocap",
    "capabilities",
    "w3c",
    "ccg",
    "zod",
    "schema",
    "validation",
    "linked-data"
  ],
  "license": "MIT",
  "author": "Benjamin Goering <ben@bengo.co>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gobengo/zcap-zod.git"
  },
  "homepage": "https://github.com/gobengo/zcap-zod#readme",
  "bugs": {
    "url": "https://github.com/gobengo/zcap-zod/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:site": "npm run build && node scripts/build-site.mjs",
    "json-schema": "node scripts/json-schema.mjs",
    "dev": "node scripts/dev.mjs",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "test": "node --test",
    "fixture:update": "npx --yes zcap-spec-examples@^0.1.0 --url=https://w3c-ccg.github.io/zcap-spec/v0.4.0-rc.2/ --format=ndjson > etc/zcap-spec-examples.ndjson"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
